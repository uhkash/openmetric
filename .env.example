# ---------------------------------------------------------------------------
# OpenMetric configuration. Copy to .env  ->  cp .env.example .env
# .env is gitignored. NEVER commit real keys. This file holds placeholders only.
# ---------------------------------------------------------------------------

# Encryption key for provider credentials at rest (Fernet, base64, 32 bytes).
# Generate one with:  openmetric init   (or)  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
OPENMETRIC_SECRET_KEY=

# Where the local database lives. SQLite by default; Postgres also works:
#   postgresql+psycopg://user:pass@localhost:5432/openmetric
OPENMETRIC_DATABASE_URL=sqlite:///./openmetric.db

# Gateway bind address
OPENMETRIC_HOST=127.0.0.1
OPENMETRIC_PORT=8099

# Admin token guarding the dashboard + management API (leave blank on localhost).
OPENMETRIC_ADMIN_TOKEN=

# Privacy. Keep these OFF unless you know what you are doing: turning them on
# stores prompt/response text in your local database.
OPENMETRIC_LOG_REQUEST_BODIES=false
OPENMETRIC_LOG_RESPONSE_BODIES=false

# Redact anything that looks like a secret from logs and error messages.
OPENMETRIC_REDACT_LOGS=true

# Upstream request timeout (seconds) and retention for raw events (days, 0 = keep forever).
OPENMETRIC_TIMEOUT_SECONDS=600
OPENMETRIC_EVENT_RETENTION_DAYS=0
